{
  "name": "@magichourhq/api-types",
  "version": "0.0.0-dev.1",
  "description": "TypeScript types for the Magic Hour API",
  "type": "module",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    }
  },
  "files": [
    "src/index.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magichourhq/api-types.git"
  },
  "scripts": {
    "generate": "yarn dlx -p openapi-typescript@7.13.0 -p typescript@5.9.3 openapi-typescript openapi.json -o src/index.d.ts",
    "check": "tsc -p tsconfig.json",
    "prepack": "yarn check"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
