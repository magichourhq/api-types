{
  "name": "@magichourhq/api-types",
  "version": "0.0.0-dev.1",
  "description": "TypeScript types for the Magic Hour API",
  "type": "module",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    }
  },
  "files": [
    "src/index.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magichourhq/api-types.git"
  },
  "scripts": {
    "generate": "openapi-ts -i openapi.json -o node_modules/.cache/api-types -p @hey-api/typescript && mv node_modules/.cache/api-types/types.gen.ts src/index.d.ts",
    "check": "tsc -p tsconfig.json",
    "prepack": "yarn check"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
